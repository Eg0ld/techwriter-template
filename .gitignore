# Dependencies
/node_modules

# Deliberately NOT committed. The Pages/init workflows use `npm install`, not
# `npm ci`, so no lockfile is required to build. Leaving it out means each tenant
# repo resolves fresh at provisioning time and picks up patched transitives
# automatically, rather than inheriting whatever tree this template was pinned to
# on the day it was last touched. The known-vulnerable transitives are held down
# by the `overrides` block in package.json, which applies with or without a lock.
# Revisit if a workflow ever switches to `npm ci`, which requires one.
/package-lock.json

# Production build output
/build

# Generated files
.docusaurus
.cache-loader

# Local environment / secrets (never commit these)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# The read-only clone the init workflow makes of the watched repo
/.watched
