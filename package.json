{
  "name": "my-docs",
  "version": "0.0.0",
  "private": true,
  "description": "A blank Docusaurus documentation site, kept in sync by Autoscribe.",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "comments": {
    "overrides": "Transitive advisories inside the Docusaurus 3.10.x tree. Docusaurus itself has no fixed release for these, so each is pinned to the lowest patched version for the major that is actually installed. Kept in step with the techwriter.ai showcase, which builds the same Docusaurus tree. Drop an entry once Docusaurus ships a tree that already satisfies it. `image-size` is knowingly absent: its advisory range is `*`, so there is no patched version to pin to."
  },
  "overrides": {
    "brace-expansion@1": "^1.1.18",
    "body-parser": "^1.20.6",
    "fast-uri@3": "^3.1.5",
    "http-proxy-middleware@2": "^2.0.10",
    "js-yaml@3": "^3.15.1",
    "js-yaml@4": "^4.3.1",
    "nanoid@3": "^3.3.18",
    "postcss": "^8.5.26",
    "serialize-javascript": "^7.1.0",
    "svgo": "^3.3.4",
    "uuid@8": "^11.1.1",
    "webpack-dev-server": "^5.2.6"
  }
}
